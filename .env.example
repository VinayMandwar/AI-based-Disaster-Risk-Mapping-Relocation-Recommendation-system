# ==============================================================================
# Aashray - Environment Configuration Example (SIH 26191)
# AI-Based Disaster Risk Mapping & Relocation Recommendation System
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Security Secret Key for JWT & Session Hashing
SECRET_KEY=demo_secret_key_change_in_production_hazardshield_2026

# PostgreSQL Database Connection URL
# For Docker Compose: postgresql://hazardshield_user:hazardshield_password@postgres:5432/hazardshield_db
# For Local Dev: postgresql+psycopg://hazardshield_user:hazardshield_password@localhost:5433/hazardshield_db
DATABASE_URL=postgresql+psycopg://hazardshield_user:hazardshield_password@localhost:5433/hazardshield_db

# Frontend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8001

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
